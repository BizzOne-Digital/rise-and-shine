# ---------- Database (MongoDB Atlas) ----------
# Atlas > Connect > Drivers. URL-encode special characters in the password.
MONGODB_URI=
MONGODB_DB_NAME=rise-n-shine

# ---------- Admin authentication ----------
# Long random string (>= 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# Public base URL of the site (used for sitemap, canonical URLs, structured data)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Media ----------
# Admin image uploads are stored in MongoDB (collection StoredUpload). No extra service or credentials needed.

# ---------- Optional email notifications (Resend) ----------
# If absent, requests are still saved; nothing is ever reported as emailed.
RESEND_API_KEY=
NOTIFY_EMAIL_TO=rnsbreakfast@gmail.com
NOTIFY_EMAIL_FROM=

# ---------- First admin (used only by `npm run create-admin`) ----------
# Prefer passing these inline on the command line rather than saving a password here.
ADMIN_EMAIL=
ADMIN_PASSWORD=
