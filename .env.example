# ---------- Database (MongoDB Atlas) ----------
# Atlas > Connect > Drivers. URL-encode special characters in the password.
MONGODB_URI=
MONGODB_DB_NAME=rise-n-shine

# ---------- Admin authentication ----------
# Long random string (>= 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# Public base URL of the site (used for sitemap, canonical URLs, structured data)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Media ----------
# Admin image uploads are stored in MongoDB (collection StoredUpload). No extra service or credentials needed.

# ---------- Email notifications (Gmail SMTP) ----------
# Contact, booking and Work with us forms email the team through Gmail. Create a Google "app password" for the sending
# account (Google Account > Security > 2-Step Verification > App passwords) and set:
SMTP_USER=rnsbreakfast@gmail.com
SMTP_PASS=
# Where the emails go (defaults to SMTP_USER). Optional:
NOTIFY_EMAIL_TO=rnsbreakfast@gmail.com
# Check the login without sending anything:  npm run test-smtp
# Optional fallback if SMTP is not set: Resend (RESEND_API_KEY, NOTIFY_EMAIL_FROM, NOTIFY_EMAIL_TO).

# ---------- First admin (used only by `npm run create-admin`) ----------
# Prefer passing these inline on the command line rather than saving a password here.
ADMIN_EMAIL=
ADMIN_PASSWORD=
