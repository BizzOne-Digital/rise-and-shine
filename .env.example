# ---------- Database (MongoDB Atlas) ----------
# Atlas > Connect > Drivers. URL-encode special characters in the password.
MONGODB_URI=
MONGODB_DB_NAME=rise-n-shine

# ---------- Admin authentication ----------
# Long random string (>= 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# Public base URL of the site (used for sitemap, canonical URLs, structured data)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Media ----------
# Admin image uploads are stored in MongoDB (collection StoredUpload). No extra service or credentials needed.

# ---------- Email notifications (Resend) ----------
# Without these three values NO form (contact, booking, work with us) can email the team. Submissions are still saved,
# but the site tells the visitor it could not deliver the message.
# Quickest setup: create a free account at resend.com using the SAME address as NOTIFY_EMAIL_TO, create an API key, and set:
#   RESEND_API_KEY=re_xxxxxxxx
#   NOTIFY_EMAIL_FROM=Rise N' Shine Website <onboarding@resend.dev>
#   NOTIFY_EMAIL_TO=rnsbreakfast@gmail.com
# (onboarding@resend.dev can only deliver to the address the Resend account was created with. To send to any inbox,
# verify the restaurant's own domain in Resend and use an address on that domain as NOTIFY_EMAIL_FROM.)
RESEND_API_KEY=
NOTIFY_EMAIL_TO=rnsbreakfast@gmail.com
NOTIFY_EMAIL_FROM=

# ---------- First admin (used only by `npm run create-admin`) ----------
# Prefer passing these inline on the command line rather than saving a password here.
ADMIN_EMAIL=
ADMIN_PASSWORD=
